# Compendio Digital UNaM — Backend
# Copiar a .env y completar. NUNCA versionar el archivo .env real (ver
# .gitignore del proyecto raíz, ya excluye .env y .env.*).

NODE_ENV=production
PUERTO=3000

# Ruta absoluta al almacén de datos (ver DTI §6.2). Por defecto, un nivel
# arriba del backend (../../almacen desde backend/src/config).
ALMACEN_RUTA=/var/www/compendio-unam/almacen

# OBLIGATORIO en producción: cadena aleatoria larga, distinta por entorno.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESION_SECRETO=

# Dominio del frontend si sirve desde un origen distinto al backend.
# Dejar vacío si frontend y backend comparten origen (recomendado, DTI §15).
ORIGEN_PERMITIDO=

NIVEL_LOG=info
